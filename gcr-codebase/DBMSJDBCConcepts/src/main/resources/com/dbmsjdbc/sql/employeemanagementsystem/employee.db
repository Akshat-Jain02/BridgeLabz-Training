/*Exercise 1: Simple CRUD Application
Create a console-based Employee Management System with:
• Add employee
• View all employees
• Update employee salary
• Delete employee
• Search employee by name */

--mysql>
 USE practice_db;
 
 /* o/p
Database changed
*/

-- mysql>
DROP TABLE IF EXISTS employee;

/* o/p
Query OK, 0 rows affected, 1 warning (0.00 sec)
*/

CREATE TABLE employee (
    emp_id INT PRIMARY KEY AUTO_INCREMENT,
    emp_name VARCHAR(100) NOT NULL,
    department VARCHAR(50),
    salary DECIMAL(10,2),
    email VARCHAR(100)
);

/* o/p
Query OK, 0 rows affected (0.11 sec)
*/

--mysql> DESC employee;

/* o/p
+------------+---------------+------+-----+---------+----------------+
| Field      | Type          | Null | Key | Default | Extra          |
+------------+---------------+------+-----+---------+----------------+
| emp_id     | int           | NO   | PRI | NULL    | auto_increment |
| emp_name   | varchar(100)  | NO   |     | NULL    |                |
| department | varchar(50)   | YES  |     | NULL    |                |
| salary     | decimal(10,2) | YES  |     | NULL    |                |
| email      | varchar(100)  | YES  |     | NULL    |                |
+------------+---------------+------+-----+---------+----------------+
5 rows in set (0.01 sec)
*/

--mysql> 
INSERT INTO employee (emp_name, department, salary, email)
    VALUES ('Amit Kumar', 'IT', 55000, 'amit@company.com'),
    ('Akshat Jain' ,'IT', 5000000, 'akshatjain@gmail.com'),
    ('Divyansh Pandey','Sales',40000,'divyansh5themail@gmail.com'),
    ('Ashish Mishra', 'Sales', 40000,'mishraashish@gmail.com');
    
    
/* o/p
Query OK, 4 rows affected (0.01 sec)
Records: 4  Duplicates: 0  Warnings: 0
*/    

